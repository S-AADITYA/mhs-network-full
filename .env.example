# ---------- Where these pages live ----------
# Must match the domain that actually serves them, because canonicals and the
# sitemaps are built from it. Change this only when you move to your own domain.
NEXT_PUBLIC_SITE_URL=https://mhs-network-full.vercel.app

# ---------- Supabase ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Force the config.json fallback even when Supabase is configured.
# CONTENT_SOURCE=config

# ---------- Marketing tags (all optional) ----------
# Each tag renders only if its id is set.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
